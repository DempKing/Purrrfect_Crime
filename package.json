{
  "name": "purrrfect-crime",
  "productName": "Purrrfect Crime",
  "version": "0.0.1",
  "private": true,
  "description": "A turn-based stealth heist game: Leo Tuxedo, cat burglar, versus bulldog guards.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/build.mjs --dev && npx http-server dist -p 8100 -c-1",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "solve": "esbuild tools/solve.ts --bundle --platform=node --outfile=.solve/solve.cjs --log-level=warning && node --max-old-space-size=8000 .solve/solve.cjs",
    "balance": "esbuild tools/balance.ts --bundle --platform=node --outfile=.solve/balance.cjs --log-level=warning && node .solve/balance.cjs"
  },
  "devDependencies": {
    "@fontsource/homemade-apple": "5.3.0",
    "@fontsource/libre-franklin": "5.3.0",
    "@fontsource/limelight": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "@fontsource/unifrakturmaguntia": "5.3.0",
    "@types/node": "22.15.0",
    "@types/three": "0.170.0",
    "esbuild": "0.24.2",
    "pixi.js": "8.21.0",
    "three": "0.170.0",
    "typescript": "5.9.3"
  }
}
